{
    "name": "@ostro/console",
    "version": "2.0.0-alpha.9",
    "description": "Command module for OstroJS",
    "main": "application.js",
    "types": ".types/application.d.ts",
    "exports": {
        ".": {
            "types": "./.types/application.d.ts",
            "default": "./application.js"
        },
        "./*": {
            "types": "./.types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.8",
        "@ostro/support": "^2.0.0-alpha.9",
        "commander": "^8.3.0",
        "lodash": "^4.17.21",
        "string-argv": "^0.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "console",
        "command",
        "cli"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/console.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/console/issues"
    },
    "homepage": "https://github.com/ostrojs/console#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
